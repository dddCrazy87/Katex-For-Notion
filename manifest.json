{
  "manifest_version": 3,
  "name": "公式複製到 Notion",
  "version": "1.3.0",
  "description": "在你指定的網站複製含公式的內容時，把公式轉成 $LaTeX$，貼進 Notion 直接變成公式。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "公式複製到 Notion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
